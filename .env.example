# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_stock_platform
DB_USER=root
DB_PASS=your_password

# OpenRouter AI
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5
OPENROUTER_MAX_TOKENS=4000

# App
APP_ENV=development
APP_URL=http://localhost
APP_DEBUG=true

# NSE cookie file path
NSE_COOKIE_FILE=/tmp/nse_cookies.txt

# Cache TTLs in seconds
CACHE_TTL_PRICE=300
CACHE_TTL_CHART=21600
CACHE_TTL_SCHEDULE=86400
CACHE_TTL_NEWS=1800
CACHE_TTL_PEERS=3600
CACHE_TTL_ANALYSIS=21600

# Email alerts (uses PHP mail())
ALERT_FROM_EMAIL=noreply@yourdomain.com

# Health endpoint protection (leave blank to make public)
HEALTH_SECRET=

# Cron authentication (cron jobs send this header to bypass rate limiting)
CRON_SECRET=change-this-to-a-random-string
